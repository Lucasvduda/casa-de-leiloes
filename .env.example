# Copie para .env (nunca commite o .env). Todas as variaveis sao validadas no boot (zod):
# configuracao invalida impede a aplicacao de subir, com mensagem clara.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL (local via `docker compose up db`, ou Neon em producao). O banco precisa ser UTF8.
DATABASE_URL=postgres://leilao:leilao@localhost:5432/leilao
# Conexoes do pool (2 a 50). Planos gratuitos limitam conexoes: o padrao e conservador.
DB_POOL_MAX=10

# Chave HMAC que sela o historico de lances. Minimo 32 caracteres. Deve ficar FORA do banco.
# Gerar uma boa:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
INTEGRITY_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais-caracteres

# true = cria 1 leiloeiro, 2 licitantes (com saldo) e 6 lotes de demonstracao se ainda nao existirem.
# Idempotente: reiniciar nao duplica. Manual: `npm run seed -w api`.
SEED_ON_BOOT=true
# Senha das 3 contas de demonstracao (leiloeiro@demo.leilao, ana@demo.leilao, bruno@demo.leilao).
# Publica de proposito: quem avalia precisa entrar. Em producao real, deixe SEED_ON_BOOT=false.
DEMO_PASSWORD=Demo-Leilao-2026!

# Regra do enunciado: so lote SEM lances pode ser cancelado (padrao false). Com true, o leiloeiro
# tambem cancela lote com lances e o lider e estornado na mesma transacao.
# ALLOW_CANCEL_WITH_BIDS=false

# Quantos proxies confiaveis ha na frente do app (Render: 1). Define o IP real usado nos limites de
# requisicao. Depois do deploy, confira o log "proxy_probe" (campos ip e forwardedFor): se o ip for
# sempre o mesmo para visitantes diferentes, aumente este numero.
# TRUST_PROXY_HOPS=1

# Cookie de sessao: em producao e Secure e usa o prefixo __Host-. Defina false SOMENTE para rodar a
# imagem de producao em http://localhost (sem HTTPS), como no docker compose.
# COOKIE_SECURE=false

# Front-end (Vite) le estas duas NA COMPILACAO, nao em tempo de execucao (no Docker: --build-arg).
# VITE_SHOW_DEMO_HINT=false esconde o quadro "Contas de demonstracao" da tela de login.
# VITE_DEMO_PASSWORD precisa ser igual a DEMO_PASSWORD acima se voce trocou a senha.
# VITE_SHOW_DEMO_HINT=true
# VITE_DEMO_PASSWORD=Demo-Leilao-2026!

# Pasta do build do front-end. Se definida, a API serve o app na mesma origem (sem CORS).
# No Docker ja vem configurada. Em desenvolvimento use o servidor do Vite.
# WEB_DIST_DIR=../web/dist
