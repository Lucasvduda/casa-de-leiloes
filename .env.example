# Copie para .env (nunca commite o .env). Todas as variaveis sao validadas no boot (zod):
# configuracao invalida impede a aplicacao de subir, com mensagem clara.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL (local via `docker compose up db`, ou Neon em producao).
DATABASE_URL=postgres://leilao:leilao@localhost:5432/leilao

# Chave HMAC que sela o historico de lances. Minimo 32 caracteres. Deve ficar FORA do banco.
# Gerar uma boa:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
INTEGRITY_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais-caracteres

# true = cria leiloeiro, 2 licitantes e lotes de demonstracao se ainda nao existirem.
SEED_ON_BOOT=true
