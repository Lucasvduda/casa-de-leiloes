{
  "name": "@leilao/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "seed": "tsx --env-file-if-exists=../.env src/seed-cli.ts",
    "seed:prod": "node dist/seed-cli.js",
    "smoke:dist": "tsx scripts/smoke-dist.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "catalog:offline": "tsx scripts/build-offline-catalog.ts",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:int",
    "test:unit": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1"
  }
}
